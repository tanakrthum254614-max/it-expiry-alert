# รหัสแอดมิน (จำเป็นบน Vercel) ทุกหน้าในระบบนี้ต้องใช้รหัสนี้
ADMIN_KEY=change-me
# Vercel สร้างให้อัตโนมัติเมื่อมี Cron ใช้ยืนยันว่าคำขอมาจาก Cron จริง
CRON_SECRET=

# ฐานข้อมูล: Upstash Redis (ติดตั้งจาก Vercel Marketplace แล้ว env จะมาเอง)
# ถ้าไม่ใส่ ตอนรันในเครื่องจะเก็บเป็นไฟล์ใน .data/
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ช่องทางแจ้งเตือน ใส่อย่างน้อย 1 ช่องทาง
# Discord / Slack / Google Chat webhook
NOTIFY_WEBHOOK_URL=
# LINE Messaging API (LINE Notify ปิดบริการแล้ว)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
